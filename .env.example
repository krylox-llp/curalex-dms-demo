# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server only (never prefix with NEXT_PUBLIC_). Used by /documents/<share>/view|download to issue
# short-lived signed URLs after the access check. Supabase project settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Invitation emails (Resend). A send-only API key is enough.
RESEND_API_KEY=re_xxxxxxxx
# Sender address; its domain must be verified in Resend. Defaults to hello@krylox.ai.
RESEND_FROM_EMAIL="CuraLex - DMS <hello@krylox.ai>"
# Public URL used for links in emails (falls back to the request's host).
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
